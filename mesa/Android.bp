
cc_prebuilt_library_shared {
    name: "libgbm_mesa",
    arch: {
        arm: {
            srcs: ["lib32/libgbm_mesa.so"],
        },
        arm64: {
            srcs: ["lib64/libgbm_mesa.so"],
        },
    },
    compile_multilib: "both",
    strip: {
        none: true,
    },
    shared_libs: [
	"dri_gbm",
        "libcutils",
        "libdrm",
        "libdl",
        "libc",
    ],
//    check_elf_files: false,
    vendor: true,
}

